#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  git clone --depth 1 --branch v0.41.0 https://github.com/nvm-sh/nvm.git "$NVM_DIR"
fi
source "$NVM_DIR/nvm.sh" --no-use

echo "Installing Node.js from .nvmrc"
time nvm install
nvm alias default "$(cat .nvmrc)"

if ! grep -Fqx '# Coderetreat orb Node.js' "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n# Coderetreat orb Node.js\nexport NVM_DIR=%q\n[ ! -s "$NVM_DIR/nvm.sh" ] || source "$NVM_DIR/nvm.sh"\n' "$NVM_DIR" >> "$HOME/.bash_profile"
fi

echo "Installing locked npm dependencies"
time npm ci --include=dev --no-audit --no-fund
